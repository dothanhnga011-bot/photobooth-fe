{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photobooth",
  "account_id": "8b23802c92443c22e78e245ca164e662",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Tệp không có → Worker (cloudflare/worker.js): thiếu tệp trong /assets, /fonts trả 404 không lưu cache;
    // đường dẫn trang (/kiosk, /admin/…) trả index.html. Trước dùng "single-page-application": tệp CSS thiếu
    // lúc đang đổi bản mới bị trả trang HTML, trình duyệt lưu nó 1 năm và trang quản trị mất giao diện.
    "not_found_handling": "none",
    // Trang chủ, quản trị, album: Worker chuyển *.workers.dev sang tên miền chính (PUBLIC_ORIGIN).
    "run_worker_first": ["/api", "/api/*", "/", "/admin", "/admin/*", "/album/*"]
  },
  // Backend Render gói Starter ($7, 0,5 CPU, 512 MB) — không ngủ, nên không cần lịch cron đánh
  // thức máy chủ như gói free (trang studio vẫn giữ cron trong wrangler.studio.jsonc).
  "vars": {
    "API_ORIGIN": "https://photobooth-be-oqcr.onrender.com",
    // Tên miền chính của tiệm (custom domain của Worker này).
    "PUBLIC_ORIGIN": "https://mellowptb.com"
  }
}